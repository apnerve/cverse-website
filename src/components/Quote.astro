---
/** Attributed quotation, set with the same left rule as the About points. */
interface Props { text: string; name: string; role: string; class?: string }
const { text, name, role, class: className = '' } = Astro.props;
---
<figure class={`border-l-2 border-line-strong pl-6 ${className}`.trim()}>
  <blockquote class="text-lg leading-relaxed text-ink-900">
    <p>“{text}”</p>
  </blockquote>
  <figcaption class="mt-3 text-sm text-ink-600">
    <span class="font-medium text-ink-900">{name}</span>, {role}
  </figcaption>
</figure>
