---
/**
 * One piece of writing: header band (kind, date, eyebrow, title, lead, tags), the case-study facts and key
 * outcomes when the kind is a case study, the Markdown body (default slot), any quotes, then the contact card.
 * Header and footer included, like LegalPage.
 */
import Header from './Header.astro';
import Footer from './Footer.astro';
import MobileCta from './MobileCta.astro';
import Section from './Section.astro';
import ChipList from './ChipList.astro';
import StatList from './StatList.astro';
import Quote from './Quote.astro';
import Contact from './Contact.astro';
import { withBase } from '../lib/base';
import { WRITING_PATH, KIND_LABELS, formatDate, type Entry } from '../lib/writing';

interface Props { base: string; entry: Entry }
const { base, entry } = Astro.props;
const d = entry.data;
const isCaseStudy = d.kind === 'case-study';
const facts = (
  [
    { term: 'Industry', value: d.industry },
    { term: 'Engagement', value: d.engagement },
    { term: 'Duration', value: d.duration },
    { term: 'Services', value: d.services?.join(', ') },
  ] as { term: string; value: string | undefined }[]
).filter((f): f is { term: string; value: string } => Boolean(f.value));
---
<Header base={base} />
<main id="main">
  <article>
    <header class="border-b border-line bg-surface">
      <div class="container-page py-16 sm:py-20">
        <p class="meta text-ink-500">
          <a href={withBase(WRITING_PATH)} class="hover:text-ink-900">Writing</a>
          <span aria-hidden="true"> · </span>{KIND_LABELS[d.kind]}
          <span aria-hidden="true"> · </span><time datetime={d.publishedAt.toISOString()}>{formatDate(d.publishedAt)}</time>
        </p>
        {d.client && <p class="mt-8 text-base font-medium text-ink-700">{d.client}</p>}
        <h1 class={`section-title max-w-3xl ${d.client ? 'mt-3' : 'mt-4'}`}>{d.title}</h1>
        <p class="lead mt-5 max-w-2xl">{d.summary}</p>
        {d.tags.length > 0 && <ChipList items={d.tags} label="Tags" class="mt-6" />}

        {isCaseStudy && (
          <dl class="mt-12 max-w-3xl space-y-5">
            {facts.map((f) => (
              <div class="grid gap-2 border-t border-line pt-5 sm:grid-cols-[13rem_1fr]">
                <dt class="meta text-ink-500">{f.term}</dt>
                <dd class="text-base text-ink-900">{f.value}</dd>
              </div>
            ))}
            {d.stack && d.stack.length > 0 && (
              <div class="grid gap-2 border-t border-line pt-5 sm:grid-cols-[13rem_1fr]">
                <dt class="meta text-ink-500">Stack</dt>
                <dd><ChipList items={d.stack} /></dd>
              </div>
            )}
          </dl>
        )}
      </div>
    </header>

    {isCaseStudy && d.outcomes && (
      <Section id="outcomes" tone="alt" heading={{ title: 'Key outcomes' }}>
        <StatList items={d.outcomes} columns={3} class="mt-12" />
      </Section>
    )}

    <Section id="story" labelledby="story-title">
      <h2 id="story-title" class="sr-only">{isCaseStudy ? 'The story' : 'The article'}</h2>
      <div class="prose max-w-3xl">
        <slot />
      </div>
      {d.quotes && d.quotes.length > 0 && (
        <div class="mt-14 max-w-3xl space-y-10">
          {d.quotes.map((q) => <Quote {...q} />)}
        </div>
      )}
    </Section>
  </article>
  <Contact />
</main>
<Footer base={base} />
<MobileCta base={base} />
