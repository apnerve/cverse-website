---
import SectionHeading from './SectionHeading.astro';
import { execStack as stack, execStackSection as section } from '../data/exec';
---
<section id="stack" class="border-b border-line bg-surface" aria-labelledby="stack-title">
  <div class="container-page py-20 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading id="stack-title" {...section} />
      </div>
      <dl class="lg:col-span-7 space-y-6">
        {stack.map((g) => (
          <div class="grid gap-3 border-b border-line pb-6 last:border-0 last:pb-0 sm:grid-cols-[13rem_1fr]">
            <dt class="text-sm font-semibold text-ink-900">{g.group}</dt>
            <dd class="flex flex-wrap gap-2">
              {g.items.map((t) => <span class="chip">{t}</span>)}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
