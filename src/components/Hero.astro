---
import { ArrowRight, Activity } from '@lucide/astro';
import Icon from './Icon.astro';
import { hero, pillars } from '../data/site';
import type { Variant } from '../data/site';

interface Props { variant: Variant }
const { variant } = Astro.props;
---
<section id="top" class="relative overflow-hidden border-b border-line bg-surface">
  {/* Background treatment per version */}
  {variant === 'motion' && (
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="hero-blob hero-blob-a -left-[10%] -top-[20%] h-[34rem] w-[34rem]" style="background: var(--spot-blue); opacity: .16"></div>
      <div class="hero-blob hero-blob-b left-[45%] -top-[30%] h-[30rem] w-[30rem]" style="background: var(--spot-indigo); opacity: .14"></div>
      <div class="hero-blob hero-blob-c -right-[12%] top-[20%] h-[28rem] w-[28rem]" style="background: var(--spot-teal); opacity: .14"></div>
      <div class="hero-blob left-[20%] top-[55%] h-[20rem] w-[20rem]" style="background: var(--spot-yellow); opacity: .10"></div>
      <div class="hero-grid absolute inset-0 opacity-70"></div>
    </div>
  )}
  {variant === 'corporate' && (
    <div aria-hidden="true" class="hero-grid pointer-events-none absolute inset-0 opacity-60"></div>
  )}
  {variant === 'dark' && (
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute inset-x-0 -top-40 mx-auto h-[32rem] w-[52rem] max-w-full rounded-full opacity-25 blur-3xl" style="background: radial-gradient(closest-side, var(--t-brand-500), transparent)"></div>
      <div class="hero-grid absolute inset-0 opacity-50"></div>
    </div>
  )}

  <div class="container-page relative py-20 sm:py-28 lg:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow rise rise-1">{hero.eyebrow}</p>
        <h1 class="rise rise-2 mt-5 text-4xl leading-[1.08] text-ink-950 sm:text-5xl lg:text-[3.5rem]" style="font-weight: var(--t-heading-weight)">
          {hero.titleLine1}<br />
          <span class="text-heading-accent">{hero.titleLine2}</span>
        </h1>
        <p class="lead rise rise-3 mt-6 max-w-xl">{hero.lead}</p>
        <div class="rise rise-4 mt-8 flex flex-wrap items-center gap-3">
          <a href={hero.primaryCta.href} class="btn btn-primary">
            {hero.primaryCta.label}
            <ArrowRight class="btn-icon h-4 w-4" aria-hidden="true" />
          </a>
          <a href={hero.secondaryCta.href} class="btn btn-secondary">{hero.secondaryCta.label}</a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <div class="card rise rise-4 overflow-hidden">
          <div class="flex items-center justify-between border-b border-line bg-surface-2 px-5 py-3.5">
            <span class="font-display text-sm font-semibold text-ink-950">{hero.panel.heading}</span>
            <span class="font-mono text-[11px] uppercase tracking-wider text-ink-500">{hero.panel.caption}</span>
          </div>
          <div class="space-y-6 p-6">
            <div class="rounded-ui bg-code-bg p-4 font-mono text-[12.5px] leading-relaxed text-code-fg">
              {hero.panel.code.map((line) =>
                'comment' in line ? (
                  <div class="text-code-dim">{line.comment}</div>
                ) : (
                  <div class:list={[line.key === 'stack' && 'mt-2']}>
                    <span class="text-code-key">{line.key}</span>: {line.highlight ? <span class="text-highlight">{line.value}</span> : line.value}
                  </div>
                )
              )}
            </div>

            <div>
              <div class="flex items-center gap-2.5">
                <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
                  <span class="absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-60 motion-safe:animate-ping"></span>
                  <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-brand-500"></span>
                </span>
                <span class="flex items-center gap-1.5 text-sm font-semibold text-ink-900">
                  <Activity class="h-4 w-4 text-brand-600" aria-hidden="true" />
                  {hero.panel.status}
                </span>
              </div>
              <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-surface-2" role="presentation">
                <div class="h-full w-3/4 rounded-full bg-brand-500"></div>
              </div>
            </div>

            <ul class="space-y-4 border-t border-line pt-5">
              {pillars.map((p) => (
                <li class="flex items-start gap-3">
                  <span class="icon-tile mt-0.5 !h-8 !w-8">
                    <Icon name={p.icon} class="h-4 w-4" />
                  </span>
                  <div>
                    <p class="text-sm font-semibold text-ink-900">{p.title}</p>
                    <p class="text-sm text-ink-600">{p.short}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
