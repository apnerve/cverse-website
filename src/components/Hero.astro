---
import { Check } from '@lucide/astro';
import CtaButton from './CtaButton.astro';
import { execHero as hero } from '../data/exec';
---
<section id="top" class="relative -mt-16 overflow-hidden border-b border-line bg-surface">
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="hero-grid absolute inset-0"></div>
  </div>

  <div class="container-page relative pb-20 pt-36 sm:pb-28 sm:pt-44 lg:pb-32 lg:pt-48">
    <div class="max-w-3xl">
      <h1 class="rise rise-1 text-4xl text-ink-950 sm:text-5xl lg:text-[3.5rem]">
        {hero.titleLine1}<br />
        <span class="text-heading-accent">{hero.titleLine2}</span>
      </h1>
      <p class="lead rise rise-2 mt-6 max-w-2xl">{hero.lead}</p>
      <div class="rise rise-3 mt-8 flex flex-wrap items-center gap-3">
        <CtaButton href={hero.primaryCta.href} label={hero.primaryCta.label} cta />
        <CtaButton href={hero.secondaryCta.href} label={hero.secondaryCta.label} variant="secondary" />
      </div>
      <ul class="rise rise-4 mt-8 flex flex-wrap gap-x-6 gap-y-2 text-sm text-ink-600" aria-label="Engagement basics">
        {hero.facts.map((f) => (
          <li class="flex items-center gap-2">
            <Check class="h-4 w-4 flex-none text-ink-500" aria-hidden="true" />
            {f}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
