---
import SectionHeading from '../SectionHeading.astro';
import { execAboutPoints as points, execAboutSection as section } from '../../data/exec';
---
<section id="about" class="border-b border-line bg-surface" aria-labelledby="about-title">
  <div class="container-page py-20 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading id="about-title" {...section} />
      </div>
      <div class="lg:col-span-7">
        <div class="space-y-6">
          {points.map((p) => (
            <div class="border-l-2 border-brand-300 pl-6">
              <h3 class="text-lg font-semibold text-ink-950">{p.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-ink-600">{p.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
