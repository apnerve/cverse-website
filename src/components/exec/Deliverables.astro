---
import Icon from './Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { execDeliverables as items, execDeliverablesSection as section } from '../../data/exec';
---
<section id="what-you-receive" class="border-b border-line bg-surface" aria-labelledby="deliverables-title">
  <div class="container-page py-20 sm:py-24">
    <SectionHeading id="deliverables-title" {...section} />
    <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {items.map((d) => (
        <li class="card flex gap-5 p-7">
          <span class="icon-tile"><Icon name={d.icon} /></span>
          <div>
            <h3 class="text-lg font-semibold leading-snug text-ink-950">{d.title}</h3>
            <p class="mt-2 text-base leading-relaxed text-ink-600">{d.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
