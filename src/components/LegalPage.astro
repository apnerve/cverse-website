---
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props { base: string; title: string; updated: string }
const { base, title, updated } = Astro.props;
---
<Header base={base} />
<main id="main" class="bg-surface">
  <article class="container-page py-16 sm:py-20">
    <div class="max-w-3xl">
      <h1 class="section-title">{title}</h1>
      <p class="mt-3 font-mono text-xs text-ink-500">Last updated: {updated}</p>
      <div class="prose-legal mt-8">
        <slot />
      </div>
    </div>
  </article>
</main>
<Footer base={base} />
