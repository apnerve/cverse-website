---
import Header from './Header.astro';
import Footer from './Footer.astro';

import type { Variant } from '../data/site';

interface Props { base: string; title: string; updated: string; variant?: Variant }
const { base, title, updated, variant } = Astro.props;
---
<Header base={base} variant={variant} />
<main id="main" class="bg-surface">
  <article class="container-page py-16 sm:py-20">
    <div class="max-w-3xl">
      <p class="eyebrow">Legal</p>
      <h1 class="section-title mt-4">{title}</h1>
      <p class="mt-3 text-sm text-ink-500">Last updated: {updated}</p>
      <div class="prose-legal mt-8">
        <slot />
      </div>
    </div>
  </article>
</main>
<Footer base={base} variant={variant} />
