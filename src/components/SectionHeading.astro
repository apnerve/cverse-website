---
interface Props { title: string; intro?: string; align?: 'left' | 'center'; id?: string }
const { title, intro, align = 'left', id } = Astro.props;
const center = align === 'center';
---
<div class={`max-w-2xl ${center ? 'mx-auto text-center' : ''}`}>
  <h2 id={id} class="section-title">{title}</h2>
  {intro && <p class={`lead mt-5 ${center ? 'mx-auto' : ''}`}>{intro}</p>}
</div>
