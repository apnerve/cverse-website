---
/**
 * Card with an icon tile, title and description; always a list item.
 * `stacked`: icon (and optional `meta`, e.g. a step number) above the title.
 * `row`: icon beside the text. The slot renders after the description.
 */
import Icon from './Icon.astro';
import type { ExecIcon } from '../data/exec';

interface Props {
  icon: ExecIcon;
  title: string;
  description: string;
  meta?: string;
  layout?: 'stacked' | 'row';
  class?: string;
}
const { icon, title, description, meta, layout = 'stacked', class: className = '' } = Astro.props;
const row = layout === 'row';
---
<li class={`card ${row ? 'flex gap-5' : 'flex flex-col'} p-7 ${className}`.trim()}>
  {row ? (
    <>
      <span class="icon-tile"><Icon name={icon} /></span>
      <div>
        <h3 class="text-lg font-semibold text-ink-950">{title}</h3>
        <p class="mt-2 text-base leading-relaxed text-ink-600">{description}</p>
        <slot />
      </div>
    </>
  ) : (
    <>
      <div class={`flex items-center ${meta ? 'justify-between' : 'gap-4'}`}>
        <span class="icon-tile"><Icon name={icon} /></span>
        {meta ? (
          <span class="font-mono text-sm font-medium text-accent" aria-hidden="true">{meta}</span>
        ) : (
          <h3 class="text-lg font-semibold text-ink-950">{title}</h3>
        )}
      </div>
      {meta && <h3 class="mt-5 text-lg font-semibold text-ink-950">{title}</h3>}
      <p class={`${meta ? 'mt-3' : 'mt-4'} text-base leading-relaxed text-ink-600`}>{description}</p>
      <slot />
    </>
  )}
</li>
