---
/**
 * Mobile counterpart of the header button: a bar fixed to the bottom of the viewport,
 * shown only while none of the page's [data-cta] buttons is on screen.
 * Driven by the observer in Header.astro. Desktop never renders it (md:hidden).
 */
import CtaButton from './CtaButton.astro';
import { execCtaLabel } from '../data/exec';

interface Props { base: string }
const { base } = Astro.props;
---
<div id="mobile-cta" class="mobile-cta fixed inset-x-0 bottom-0 z-40 border-t border-line bg-surface/90 backdrop-blur-md md:hidden" data-hidden>
  <div class="container-page">
    <CtaButton href={`${base}#contact`} label={execCtaLabel} class="w-full" />
  </div>
</div>
<!-- Keeps the last lines of the footer clear of the bar. -->
<div class="mobile-cta-spacer md:hidden" aria-hidden="true"></div>

<style>
  .mobile-cta {
    padding: 0.75rem 0 calc(0.75rem + env(safe-area-inset-bottom, 0px));
    transition: opacity 220ms ease, transform 220ms ease, visibility 220ms;
  }
  .mobile-cta[data-hidden] { opacity: 0; transform: translateY(100%); visibility: hidden; }
  .mobile-cta-spacer { height: calc(4.25rem + env(safe-area-inset-bottom, 0px)); }
  @media (prefers-reduced-motion: reduce) {
    .mobile-cta { transition: none; }
  }
</style>
