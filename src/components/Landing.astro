---
import Header from './Header.astro';
import Hero from './Hero.astro';
import Services from './Services.astro';
import Stack from './Stack.astro';
import How from './How.astro';
import Deliverables from './Deliverables.astro';
import Faq from './Faq.astro';
import CaseStudies from './CaseStudies.astro';
import About from './About.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import MobileCta from './MobileCta.astro';

interface Props { base: string }
const { base } = Astro.props;
---
<Header base={base} />
<main id="main">
  <Hero />
  <Services />
  <Stack />
  <How />
  <Deliverables />
  <Faq />
  <CaseStudies />
  <About />
  <Contact />
</main>
<Footer base={base} />
<MobileCta base={base} />
