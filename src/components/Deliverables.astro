---
import Section from './Section.astro';
import FeatureCard from './FeatureCard.astro';
import { execDeliverables as items, execDeliverablesSection as section } from '../data/exec';
---
<Section id="what-you-receive" heading={section}>
  <ul class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    {items.map((d) => <FeatureCard layout="row" icon={d.icon} title={d.title} description={d.description} />)}
  </ul>
</Section>
