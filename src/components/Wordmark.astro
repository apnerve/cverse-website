---
/**
 * The outlined "cverse_" wordmark from brand/wordmark.svg, inlined so "verse"
 * takes the surrounding text colour and the cursor can blink via CSS.
 */
import raw from '../../brand/wordmark.svg?raw';

interface Props { height?: number; class?: string }
const { height = 18, class: className = '' } = Astro.props;
const svg = raw
  .trim()
  .replace(' width="978" height="176"', ` height="${height}"`)
  .replace('<svg ', `<svg class="wordmark ${className}" `);
---
<Fragment set:html={svg} />
