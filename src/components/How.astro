---
import Section from './Section.astro';
import FeatureCard from './FeatureCard.astro';
import { execSteps as steps, execHowSection as section } from '../data/exec';
---
<Section id="how-we-work" tone="alt" heading={section}>
  <ol class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {steps.map((s) => <FeatureCard icon={s.icon} meta={s.step} title={s.title} description={s.description} />)}
  </ol>
</Section>
