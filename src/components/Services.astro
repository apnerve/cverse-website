---
import Section from './Section.astro';
import FeatureCard from './FeatureCard.astro';
import ChipList from './ChipList.astro';
import { execServices as services, execServicesSection as section } from '../data/exec';
---
<Section id="services" tone="alt" heading={section}>
  <ul class="mt-14 grid gap-6 md:grid-cols-2">
    {services.map((s, i) => (
      <FeatureCard icon={s.icon} title={s.title} description={s.description} class={`spot-${i + 1}`}>
        <p class="mt-4 flex-1 border-l-2 border-line-strong pl-4 text-sm leading-relaxed text-ink-700">{s.fit}</p>
        <ChipList items={s.tags} label="Capabilities" class="mt-5 border-t border-line pt-5" />
      </FeatureCard>
    ))}
  </ul>
</Section>
