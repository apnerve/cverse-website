---
/**
 * Card linking to one piece of writing; always a list item. The whole card is clickable through the
 * stretched heading link, so each card contributes exactly one link.
 */
import { ArrowRight } from '@lucide/astro';
import ChipList from './ChipList.astro';
import { KIND_LABELS, formatDate, type Kind } from '../lib/writing';

interface Props {
  href: string;
  title: string;
  summary: string;
  kind: Kind;
  publishedAt: Date;
  tags: string[];
  headingTag?: 'h2' | 'h3';
}
const { href, title, summary, kind, publishedAt, tags, headingTag = 'h3' } = Astro.props;
const Heading = headingTag;
---
<li class="card relative flex flex-col p-7">
  <p class="meta text-ink-500">
    {KIND_LABELS[kind]}<span aria-hidden="true"> · </span><time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
  </p>
  <Heading class="mt-4 text-lg font-semibold text-ink-950">
    <a href={href} class="after:absolute after:inset-0">{title}</a>
  </Heading>
  <p class="mt-3 text-base leading-relaxed text-ink-600">{summary}</p>
  {tags.length > 0 && <ChipList items={tags} label="Tags" class="mt-5" />}
  <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-ink-900" aria-hidden="true">
    Read <ArrowRight class="h-4 w-4" />
  </span>
</li>
