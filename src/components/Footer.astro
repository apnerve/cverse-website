---
import { Mail, MapPin } from '@lucide/astro';
import Logo from './Logo.astro';
import { site } from '../data/site';
import { execFooter as footer } from '../data/exec';

interface Props { base: string }
const { base } = Astro.props;
const year = new Date().getFullYear();
const socials = [
  site.social.linkedin && { label: 'LinkedIn', href: site.social.linkedin, kind: 'linkedin' as const },
  site.social.x && { label: 'X (Twitter)', href: site.social.x, kind: 'x' as const },
].filter(Boolean) as { label: string; href: string; kind: 'linkedin' | 'x' }[];
---
<footer class="bg-footer-bg text-footer-fg" aria-label="Site footer">
  <div class="container-page py-16 sm:py-20">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo base={base} size="lg" inverted />
        <p class="mt-5 max-w-md text-sm leading-relaxed text-footer-muted">{footer.blurb}</p>
        <ul class="mt-6 flex gap-3" aria-label="Social and contact links">
          {socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}
                 class="flex h-10 w-10 items-center justify-center rounded-ui bg-footer-chip transition-colors hover:bg-footer-fg hover:text-footer-bg">
                {s.kind === 'linkedin' ? (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
                ) : (
                  <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                )}
              </a>
            </li>
          ))}
          <li>
            <a href={`mailto:${site.email}`} aria-label="Email"
               class="flex h-10 w-10 items-center justify-center rounded-ui bg-footer-chip transition-colors hover:bg-footer-fg hover:text-footer-bg">
              <Mail class="h-5 w-5" aria-hidden="true" />
            </a>
          </li>
        </ul>
      </div>

      <div class="md:col-span-3">
        <h2 class="text-sm font-semibold text-footer-fg">{footer.servicesHeading}</h2>
        <ul class="mt-5 space-y-3">
          {footer.serviceLinks.map((label) => (
            <li><a href={`${base}#services`} class="text-sm text-footer-muted transition-colors hover:text-footer-fg">{label}</a></li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-4">
        <h2 class="text-sm font-semibold text-footer-fg">{footer.contactHeading}</h2>
        <ul class="mt-5 space-y-3 text-sm text-footer-muted">
          <li class="flex items-center gap-2.5">
            <Mail class="h-4 w-4 flex-none" aria-hidden="true" />
            <a href={`mailto:${site.email}`} class="transition-colors hover:text-footer-fg">{site.email}</a>
          </li>
          <li class="flex items-start gap-2.5">
            <MapPin class="mt-0.5 h-4 w-4 flex-none" aria-hidden="true" />
            <address class="not-italic">
              {site.address.lines[0]}<br />{site.address.lines[1]}
            </address>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-4 border-t border-footer-line pt-8 text-xs text-footer-muted sm:flex-row sm:items-center">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <ul class="flex gap-6">
        {footer.legalLinks.map((l) => (
          <li><a href={`${base}${l.href}`} class="transition-colors hover:text-footer-fg">{l.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
