---
/** Home-page section: the newest case studies, with a link to the full list. No heading: the cards carry it. Renders nothing while the collection is empty. */
import Section from './Section.astro';
import CaseStudyCard from './CaseStudyCard.astro';
import CtaButton from './CtaButton.astro';
import { execCaseStudiesSection as section } from '../data/exec';
import { getPublishedCaseStudies, caseStudyHref, CASE_STUDIES_PATH } from '../lib/case-studies';
import { withBase } from '../lib/base';

const studies = (await getPublishedCaseStudies()).slice(0, 3);
---
{studies.length > 0 && (
  <Section id="client-work">
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" aria-label="Case studies">
      {studies.map((s) => (
        <CaseStudyCard
          href={caseStudyHref(s)}
          title={s.data.title}
          summary={s.data.summary}
          industry={s.data.industry}
          duration={s.data.duration}
          stack={s.data.stack}
        />
      ))}
    </ul>
    <CtaButton href={withBase(CASE_STUDIES_PATH)} label={section.cta} variant="secondary" class="mt-10" />
  </Section>
)}
