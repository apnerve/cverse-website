---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { pillars, whySection } from '../data/site';
---
<section id="why-cverse" class="border-b border-line bg-surface" aria-labelledby="why-title">
  <div class="container-page py-20 sm:py-24">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHeading id="why-title" {...whySection} />
      </div>
      <div class="lg:col-span-7">
        <div class="space-y-8">
          {pillars.map((p) => (
            <div class="flex gap-5 border-b border-line pb-8 last:border-0 last:pb-0">
              <span class="icon-tile"><Icon name={p.icon} /></span>
              <div>
                <h3 class="text-lg font-semibold text-ink-950">{p.title}</h3>
                <p class="mt-1.5 text-base leading-relaxed text-ink-600">{p.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
