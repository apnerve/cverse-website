---
import Wordmark from './Wordmark.astro';

interface Props { base: string; size?: 'sm' | 'lg'; inverted?: boolean }
const { base, size = 'sm', inverted = false } = Astro.props;
---
<a href={base} class={`flex items-center ${inverted ? 'text-footer-fg' : 'text-ink-950'}`} aria-label="cverse home">
  <Wordmark height={size === 'lg' ? 22 : 18} />
</a>
