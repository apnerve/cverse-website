---
import Section from './Section.astro';
import { execFaq as faq, execFaqSection as section } from '../data/exec';
---
<Section id="faq" tone="alt" heading={section}>
  <dl class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-2">
    {faq.map((f) => (
      <div class="border-t border-line pt-6">
        <dt class="text-lg font-semibold text-ink-950">{f.q}</dt>
        <dd class="mt-2 text-base leading-relaxed text-ink-600">{f.a}</dd>
      </div>
    ))}
  </dl>
</Section>
