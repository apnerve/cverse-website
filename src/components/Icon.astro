---
import {
  Bot, ChartLine, Workflow, Lock, Gauge, Server, Users, Phone, Search, GitBranch, Handshake, FileCheck, Database,
} from '@lucide/astro';
import type { ExecIcon } from '../data/exec';

interface Props { name: ExecIcon; class?: string }
const { name, class: className = 'h-5 w-5' } = Astro.props;
const map = {
  'bot': Bot,
  'chart-line': ChartLine,
  'workflow': Workflow,
  'lock': Lock,
  'gauge': Gauge,
  'server': Server,
  'users': Users,
  'phone': Phone,
  'search': Search,
  'git-branch': GitBranch,
  'handshake': Handshake,
  'file-check': FileCheck,
  'database': Database,
};
const Component = map[name];
---
<Component class={className} aria-hidden="true" stroke-width={1.75} />
