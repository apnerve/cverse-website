---
import Shell from '../../layouts/DarkShell.astro';
import LegalPage from '../../components/LegalPage.astro';
import TermsContent from '../../components/TermsContent.astro';
import { site } from '../../data/site';
import { withBase } from '../../lib/base';
const base = withBase('/dark/');
---
<Shell path="/dark/terms/" title={`Terms of Service — ${site.name}`} description={`Terms governing use of the ${site.name} website.`}>
  <LegalPage base={base} title="Terms of Service" updated="17 November 2026">
    <TermsContent />
  </LegalPage>
</Shell>
