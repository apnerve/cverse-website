---
import Shell from '../layouts/Shell.astro';
import LegalPage from '../components/LegalPage.astro';
import PrivacyContent from '../components/PrivacyContent.astro';
import { site } from '../data/site';
import { withBase } from '../lib/base';
const base = withBase('/');
---
<Shell path="/privacy/" title={`Privacy Policy — ${site.name}`} description={`How ${site.legalName} handles personal data on ${site.name}.`}>
  <LegalPage base={base} title="Privacy Policy" updated="18 November 2026">
    <PrivacyContent />
  </LegalPage>
</Shell>
