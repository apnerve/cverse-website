---
import Shell from '../../layouts/Shell.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileCta from '../../components/MobileCta.astro';
import Contact from '../../components/Contact.astro';
import WritingList from '../../components/WritingList.astro';
import { execWritingSection as section } from '../../data/exec';
import { site } from '../../data/site';
import { withBase } from '../../lib/base';
import { getPublished, WRITING_PATH } from '../../lib/writing';

const base = withBase('/');
const entries = await getPublished();
---
<Shell path={WRITING_PATH} title={`Writing — ${site.name}`} description={section.intro}>
  <Header base={base} />
  <main id="main">
    <WritingList entries={entries} current="all" />
    <Contact />
  </main>
  <Footer base={base} />
  <MobileCta base={base} />
</Shell>
