---
import Shell from '../../layouts/Shell.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileCta from '../../components/MobileCta.astro';
import Contact from '../../components/Contact.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { execCaseStudiesSection as section } from '../../data/exec';
import { site } from '../../data/site';
import { withBase } from '../../lib/base';
import { getPublishedCaseStudies, caseStudyHref, CASE_STUDIES_PATH } from '../../lib/case-studies';

const base = withBase('/');
const studies = await getPublishedCaseStudies();
---
<Shell path={CASE_STUDIES_PATH} title={`Case studies — ${site.name}`} description={section.intro}>
  <Header base={base} />
  <main id="main">
    <section class="border-b border-line bg-surface" aria-labelledby="case-studies-title">
      <div class="container-page py-16 sm:py-20">
        <h1 id="case-studies-title" class="sr-only">Case studies</h1>
        <ul class="grid gap-6 md:grid-cols-2" aria-label="Case studies">
          {studies.map((s) => (
            <CaseStudyCard
              href={caseStudyHref(s)}
              title={s.data.title}
              summary={s.data.summary}
              industry={s.data.industry}
              duration={s.data.duration}
              stack={s.data.stack}
              headingTag="h2"
            />
          ))}
        </ul>
      </div>
    </section>
    <Contact />
  </main>
  <Footer base={base} />
  <MobileCta base={base} />
</Shell>
