---
import { render } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import Shell from '../../layouts/Shell.astro';
import CaseStudyPage from '../../components/CaseStudyPage.astro';
import { site } from '../../data/site';
import { withBase } from '../../lib/base';
import { getPublishedCaseStudies, caseStudyPath } from '../../lib/case-studies';

export async function getStaticPaths() {
  const entries = await getPublishedCaseStudies();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const path = caseStudyPath(entry);
const published = entry.data.publishedAt.toISOString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: published,
  mainEntityOfPage: new URL(path, site.url).href,
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
};
---
<Shell path={path} type="article" title={`${entry.data.title} — ${site.name}`} description={entry.data.summary}>
  <Fragment slot="head">
    <meta property="article:published_time" content={published} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <CaseStudyPage base={withBase('/')} entry={entry}>
    <Content />
  </CaseStudyPage>
</Shell>
