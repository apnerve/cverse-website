---
import '../styles/global.css';
import '../styles/theme.css';
import { withBase } from '../lib/base';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found — cverse</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
  </head>
  <body class="min-h-screen bg-surface">
    <main id="main" class="container-page flex min-h-screen flex-col items-start justify-center py-16">
      <h1 class="section-title">Page not found</h1>
      <p class="lead mt-4">The page you were looking for does not exist or has moved.</p>
      <a href={withBase('/')} class="btn btn-primary mt-8">Back to home</a>
    </main>
  </body>
</html>
